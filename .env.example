# Copy to .env and adjust. Every variable is optional; the defaults are shown.
# Real environment variables (e.g. in CI) take precedence over this file.

# Application under test.
BASE_URL=https://automationexercise.com

# Parallel workers. Kept low because the target is a shared public demo site.
WORKERS=2
# Retries per failed test. Default: 2 when CI is set, otherwise 0.
# RETRIES=0

# Generated test users: email domain and password.
# example.com is reserved (RFC 2606), so no real mailbox ever receives mail.
TEST_EMAIL_DOMAIN=example.com
TEST_USER_PASSWORD=QaPassword123!

# Optional JSON file with environment-specific test data: user profile, main product and
# catalogue-dependent search terms. See test-data.example.json and the README.
# TEST_DATA_FILE=test-data.example.json

# Optional overrides for the main product. They take precedence over TEST_DATA_FILE,
# so leave them commented out when you use a test data file.
# PRODUCT_SEARCH_TERM=Blue Top
# PRODUCT_NAME=Blue Top
# PRODUCT_PRICE=Rs. 500
# PRODUCT_AVAILABILITY=In Stock
# PRODUCT_QUANTITY=3
